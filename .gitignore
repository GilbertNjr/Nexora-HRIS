# ==========================================
# DEPENDENCIES
# ==========================================
node_modules/
.pnp
.pnp.js
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# ==========================================
# ENVIRONMENT VARIABLES & SECRETS (CRITICAL!)
# ==========================================
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local
!.env.example

# Key certificates & security tokens
*.pem
*.key
*.cert
*.crt
id_rsa
id_rsa.pub

# ==========================================
# BUILD OUTPUTS & COMPILED CODE
# ==========================================
dist/
build/
.next/
out/
*.tsbuildinfo
.output/

# ==========================================
# DATABASE, MIGRATION & LOCAL STORAGE
# ==========================================
# Local database files & dumps
*.sql
*.sqlite
*.sqlite3
*.db
*.dump

# Local uploads (KTP, selfie presensi, surat dokter, slip gaji lokal)
/uploads/
/storage/
/temp/
apps/*/uploads/
apps/*/storage/
apps/*/temp/

# ==========================================
# LOGS & DEBUGGING
# ==========================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# ==========================================
# TESTING & CODE COVERAGE
# ==========================================
coverage/
.nyc_output/
*.lcov
test-results/

# ==========================================
# IDE & OPERATING SYSTEM ARTIFACTS
# ==========================================
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/
.DS_Store
.AppleDouble
.LSOverride

.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ==========================================
# MISCELLANEOUS & CACHES
# ==========================================
.turbo/
.cache/
.eslintcache
.stylelintcache
