# Backend API Environment Variables
NODE_ENV=development
APP_PORT=4000
APP_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000
API_PREFIX=/api/v1

# Security & Secrets
JWT_SECRET=super-secret-jwt-signing-key-min-64-characters-long-nexora-hris
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=super-secret-refresh-key-min-64-characters-long-nexora-hris
JWT_REFRESH_EXPIRATION=7d
DATA_ENCRYPTION_KEY=32-bytes-base64-aes-key-for-pii-columns-demo

# Database URL (PostgreSQL / Supabase)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nexora_hris?schema=public
