{
  "name": "nexora-hris",
  "version": "0.1.0",
  "private": true,
  "description": "NEXORA — Enterprise Human Resource Information System (HRIS)",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:api": "npm run start:dev --workspace=apps/api",
    "dev:web": "npm run dev --workspace=apps/web",
    "db:migrate": "npm run prisma:migrate --workspace=apps/api",
    "db:deploy": "npx --workspace=apps/api prisma migrate deploy",
    "db:seed": "npm run prisma:seed --workspace=apps/api",
    "db:studio": "npm run prisma:studio --workspace=apps/api",
    "build": "npm run build --workspaces --if-present",
    "build:api": "npm run prisma:generate --workspace=apps/api && npm run build --workspace=apps/api",
    "start:api": "npm run start:prod --workspace=apps/api",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "keywords": [
    "hris",
    "human-resources",
    "payroll",
    "attendance",
    "leave-management",
    "modular-monolith",
    "nestjs",
    "nextjs",
    "typescript"
  ],
  "author": "Ahmat Gebyar Gumelar <ahmadgebyar90@gmail.com>",
  "license": "UNLICENSED"
}
